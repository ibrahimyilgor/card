generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model account {
  id              Int                    @id @default(autoincrement())
  accountname     String                 @unique @db.VarChar(255)
  email           String?                @unique @db.VarChar(255)
  password_hash   String                 @db.VarChar(255)
  created_at      DateTime?              @default(now()) @db.Timestamp(6)
  last_login_date DateTime?              @db.Timestamp(6)
  achievements    account_achievements[]
  dailyStats      account_daily_stats[]
  preferences     account_preferences?
  decks           deck[]
}

model account_preferences {
  account_id       Int       @id
  language         String?   @default("en") @db.VarChar(10)
  theme_preference String?   @default("light") @db.VarChar(10)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  account          account   @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model account_daily_stats {
  account_id              Int
  review_date             DateTime @db.Timestamp(6)
  total_decks_review_done Int?     @default(0)
  account                 account  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([account_id, review_date])
}

model deck {
  id                 Int         @id @default(autoincrement())
  account_id         Int?
  title              String      @db.VarChar(255)
  description        String?
  mode               String?     @default("standard") @db.VarChar(50)
  difficulty_enabled Boolean?    @default(false)
  created_at         DateTime?   @default(now()) @db.Timestamp(6)
  updated_at         DateTime?   @default(now()) @db.Timestamp(6)
  account            account?    @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  flashcards         flashcard[]
}

model flashcard {
  id            Int       @id @default(autoincrement())
  deck_id       Int?
  front_text    String
  back_text     String
  difficulty    Int?      @default(3)
  correct_count Int?      @default(0)
  wrong_count   Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  deck          deck?     @relation(fields: [deck_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model achievement {
  id          Int                    @id @default(autoincrement())
  name        String                 @db.VarChar(255)
  description String?
  accounts    account_achievements[]
}

model account_achievements {
  account_id     Int
  achievement_id Int
  done_count     Int?        @default(0)
  earned_at      DateTime?   @default(now()) @db.Timestamp(6)
  account        account     @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  achievement    achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([account_id, achievement_id])
}
